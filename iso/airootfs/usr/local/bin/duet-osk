#!/bin/bash
# duet-osk show|hide|toggle: control the wvkbd on-screen keyboard
# (wvkbd: SIGUSR1 = hide, SIGUSR2 = show, SIGRTMIN = toggle).
pgrep -x wvkbd-mobintl >/dev/null || { wvkbd-mobintl --hidden -L 300 -H 340 >/dev/null 2>&1 & sleep 0.5; }
case ${1:-toggle} in
    show)   pkill -USR2 -x wvkbd-mobintl ;;
    hide)   pkill -USR1 -x wvkbd-mobintl ;;
    toggle) pkill -RTMIN -x wvkbd-mobintl ;;
esac
