// Windows 11-style taskbar: bottom, Start + search + apps centred,
// tray / quick settings (Wi-Fi, volume, battery) / clock on the right.
// Icons are Font Awesome glyphs (monochrome, like Windows' tray icons).
{
    "layer": "top",
    "position": "bottom",
    "height": 48,
    "spacing": 0,
    "modules-left": [],
    "modules-center": ["custom/start", "custom/search", "wlr/taskbar"],
    "modules-right": ["tray", "custom/osk", "group/quick", "clock"],

    "custom/start":  { "format": "", "tooltip-format": "Start", "on-click": "duet-launcher" },
    "custom/search": { "format": "", "tooltip-format": "Search", "on-click": "duet-launcher" },
    "custom/osk":    { "format": "", "tooltip-format": "Touch keyboard", "on-click": "duet-osk toggle" },

    "wlr/taskbar": {
        "format": "{icon}", "icon-size": 26, "tooltip-format": "{title}",
        "on-click": "activate", "on-click-middle": "close", "on-click-right": "minimize-raise"
    },

    "group/quick": {
        "orientation": "horizontal",
        "modules": ["network", "pulseaudio", "battery"]
    },
    "network": {
        "format-wifi": "", "format-ethernet": "", "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)", "tooltip-format-disconnected": "Not connected",
        "on-click": "duet-quick"
    },
    "pulseaudio": {
        "format": "{icon}", "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "tooltip-format": "Volume {volume}%",
        "on-click": "duet-quick", "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}", "format-charging": " {icon}", "format-plugged": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}% · {timeTo}",
        "on-click": "duet-quick"
    },

    "clock": {
        "format": "{:%I:%M %p\n%d-%m-%Y}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "justify": "right"
    },
    "tray": { "icon-size": 18, "spacing": 8 }
}
