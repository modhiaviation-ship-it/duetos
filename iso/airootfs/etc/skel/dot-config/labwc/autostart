# DuetOS session autostart (labwc runs this with sh)
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XCURSOR_THEME XCURSOR_SIZE QT_QPA_PLATFORMTHEME >/dev/null 2>&1
duet-display
swaybg -i /usr/share/backgrounds/duetos/default.png -m fill -c '#c9daf0' >/dev/null 2>&1 &
waybar >/dev/null 2>&1 &
mako >/dev/null 2>&1 &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
nm-applet --indicator >/dev/null 2>&1 &
wvkbd-mobintl --hidden -L 300 -H 340 >/dev/null 2>&1 &
duet-tabletmode >/dev/null 2>&1 &
duet-rotate >/dev/null 2>&1 &
duet-gestures >/dev/null 2>&1 &
duet-idle >/dev/null 2>&1 &
[ -d /run/archiso ] && notify-send -t 15000 "Welcome to DuetOS (live)" "Click the Wi-Fi / volume / battery icons (bottom right) → Install DuetOS. Nothing is saved in the live session." &
