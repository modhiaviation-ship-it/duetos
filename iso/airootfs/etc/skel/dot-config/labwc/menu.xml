<?xml version="1.0" encoding="UTF-8"?>
<!-- Right-click (two-finger click) on the desktop. -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Start"><action name="Execute" command="duet-launcher" /></item>
    <item label="File Explorer"><action name="Execute" command="pcmanfm" /></item>
    <item label="Browser"><action name="Execute" command="firefox" /></item>
    <item label="Terminal"><action name="Execute" command="foot" /></item>
    <item label="Task Manager"><action name="Execute" command="duet-taskmgr" /></item>
    <separator />
    <item label="Quick settings"><action name="Execute" command="duet-quick" /></item>
    <item label="Show desktop"><action name="ToggleShowDesktop" /></item>
    <item label="Refresh"><action name="Reconfigure" /></item>
    <separator />
    <item label="Sleep"><action name="Execute" command="systemctl suspend" /></item>
    <item label="Restart"><action name="Execute" command="systemctl reboot" /></item>
    <item label="Shut down"><action name="Execute" command="systemctl poweroff" /></item>
  </menu>
</openbox_menu>
